#pragma once

// Copy this file to secrets.h and fill in real values.
// secrets.h is gitignored.

// ---- WiFi (bridge only) ----
#define WIFI_SSID     "YourSSID"
#define WIFI_PASSWORD "YourPassword"

// ---- MQTT (bridge only) ----
#define MQTT_HOST       "192.168.1.100"
#define MQTT_PORT       1883
#define MQTT_USER       "mqtt_user"
#define MQTT_PASSWORD   "mqtt_pass"
#define MQTT_CLIENT_ID  "espnow_bridge"

// ---- ESP-NOW (senders) ----
// Bridge MAC printed by bridge on boot.
#define BRIDGE_MAC { 0x84, 0x1F, 0xE8, 0x1A, 0xA8, 0x40 }

// Must match the WiFi channel of your router (printed by bridge on boot).
#define ESPNOW_CHANNEL 3
